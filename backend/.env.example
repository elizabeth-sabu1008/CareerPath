# Server Port
PORT=5000

# Client URL for CORS
CORS_ORIGIN=http://localhost:5173

# MongoDB Connection String (leave blank or invalid to test automatic in-memory MongoDB fallback)
MONGO_URI=mongodb://localhost:27017/careerpath

# LinkedIn Analytics API Token (optional - falls back to ₹8-40L and High demand if omitted/invalid)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Firebase Admin SDK Configuration (Service Account)
# Note: For private key, ensure \n are preserved as literal \n in string
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

